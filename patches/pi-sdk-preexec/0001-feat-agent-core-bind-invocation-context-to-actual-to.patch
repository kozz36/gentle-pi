+import { type AssistantMessage, createAssistantMessageEventStream } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { expect, it } from "vitest";
+import { Agent } from "../src/agent.ts";
+import { runToolCall } from "../src/agent-loop.ts";
+import type { ToolExecutionContext } from "../src/tool-execution-context.ts";
+import {
+	bindToolExecutionContext,
+	isToolExecutionContext,
+	registerToolExecutionContext,
+} from "../src/tool-execution-context.ts";
+import type { AgentTool } from "../src/types.ts";
+
+const assistantMessage: AssistantMessage = {
+	role: "assistant",
+	content: [],
+	api: "openai-responses",
+	provider: "openai",
+	model: "mock",
+	usage: {
+		input: 0,
+		output: 0,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 0,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	},
+	stopReason: "toolUse",
+	timestamp: 0,
+};
+
+it("rejects required final admission before invoking an unknown executor", async () => {
+	let executions = 0;
+	const tool: AgentTool = {
+		name: "bash",
+		label: "bash",
+		description: "instrumented",
+		parameters: Type.Object({}),
+		execute: async () => {
+			executions++;
+			return { content: [], details: undefined };
+		},
+	};
+	const outcome = await runToolCall(
+		{ type: "toolCall", id: "same", name: "bash", arguments: {} },
+		{
+			tools: [tool],
+			context: { messages: [], tools: [tool] },
+			assistantMessage,
+			beforeToolCall: async () => ({ block: false, admission: { isValid: () => true, approve: async () => true } }),
+		},
+	);
+	expect(executions).toBe(0);
+	expect(outcome.isError).toBe(true);
+});
+
+it("preserves the four-argument legacy call and receiver", async () => {
+	let actualArgs = 0;
+	let receiver: unknown;
+	const tool: AgentTool = {
+		name: "legacy",
+		label: "legacy",
+		description: "legacy",
+		parameters: Type.Object({}),
+		async execute(...args: Parameters<AgentTool["execute"]>) {
+			actualArgs = args.length;
+			receiver = this;
+			return { content: [], details: undefined };
+		},
+	};
+	const result = await runToolCall(
+		{ type: "toolCall", id: "same", name: "legacy", arguments: {} },
+		{
+			tools: [tool],
+			context: { messages: [], tools: [tool] },
+			assistantMessage,
+		},
+	);
+	expect(result.isError).toBe(false);
+	expect(actualArgs).toBe(4);
+	expect(receiver).toBe(tool);
+});
+
+it("rejects copied metadata and a replaced bound delegate before invoking either executor", async () => {
+	let calls = 0;
+	const native: AgentTool = {
+		name: "bash",
+		label: "bash",
+		description: "instrumented",
+		parameters: Type.Object({}),
+		execute: async () => {
+			calls++;
+			return { content: [], details: undefined };
+		},
+	};
+	registerToolExecutionContext(native.execute, () => true);
+	const delegate = native.execute;
+	const wrapper: AgentTool = {
+		...native,
+		execute: (id, params, signal, update, context) => native.execute(id, params, signal, update, context),
+	};
+	bindToolExecutionContext(wrapper.execute, delegate, () => native.execute === delegate);
+	const result = await runToolCall(
+		{ type: "toolCall", id: "same", name: "bash", arguments: {} },
+		{
+			tools: [wrapper],
+			context: { messages: [], tools: [wrapper] },
+			assistantMessage,
+			beforeToolCall: async () => {
+				native.execute = async () => {
+					calls++;
+					return { content: [], details: undefined };
+				};
+				return { admission: { isValid: () => true, approve: async () => true } };
+			},
+		},
+	);
+	expect(result.isError).toBe(true);
+	expect(calls).toBe(0);
+});
+
+it.each(["return", "throw", "cancel"])("clears nested legacy scope and exits native scope after %s", async (mode) => {
+	const events: { phase: string; context: ToolExecutionContext | undefined }[] = [];
+	let frame: unknown;
+	let nestedArgs = 0;
+	const abort = new AbortController();
+	const legacy: AgentTool = {
+		name: "legacy",
+		label: "legacy",
+		description: "legacy",
+		parameters: Type.Object({}),
+		async execute(...args: Parameters<AgentTool["execute"]>) {
+			nestedArgs = args.length;
+			expect(this).toBe(legacy);
+			expect(events.at(-1)).toEqual({ phase: "enter", context: undefined });
+			if (mode === "throw") throw new Error("owned nested error");
+			if (mode === "cancel") abort.abort();
+			return { content: [], details: undefined };
+		},
+	};
+	const tools: AgentTool[] = [legacy];
+	const native: AgentTool = {
+		name: "native",
+		label: "native",
+		description: "native",
+		parameters: Type.Object({}),
+		execute: async (_id, _params, _signal, _update, context) => {
+			frame = context;
+			expect(events.at(-1)).toEqual({ phase: "enter", context });
+			const nested = await runToolCall(
+				{ type: "toolCall", id: "reused", name: "legacy", arguments: {} },
+				{
+					tools,
+					context: { messages: [], tools },
+					assistantMessage,
+				},
+			);
+			expect(nested.isError).toBe(mode === "throw");
+			expect(events.at(-1)).toEqual({ phase: "exit", context: undefined });
+			if (!isToolExecutionContext(context)) throw new Error("Missing host context");
+			await context.admit({ command: "harmless" });
+			return { content: [], details: undefined };
+		},
+	};
+	const scope = async <T>(context: ToolExecutionContext | undefined, invoke: () => Promise<T>): Promise<T> => {
+		events.push({ phase: "enter", context });
+		try {
+			return await invoke();
+		} finally {
+			events.push({ phase: "exit", context });
+		}
+	};
+	registerToolExecutionContext(native.execute, () => true, scope);
+	const delegate = native.execute;
+	const forwarder: AgentTool = {
+		...native,
+		execute: (id, args, signal, update, context) => native.execute(id, args, signal, update, context),
+	};
+	bindToolExecutionContext(forwarder.execute, delegate, () => native.execute === delegate);
+	tools.push(forwarder);
+	const result = await runToolCall(
+		{ type: "toolCall", id: "reused", name: "native", arguments: {} },
+		{
+			tools,
+			context: { messages: [], tools },
+			assistantMessage,
+			signal: abort.signal,
+			beforeToolCall: async () => ({ admission: { isValid: () => true, approve: async () => true } }),
+		},
+	);
+	expect(result.isError).toBe(mode === "cancel");
+	expect(nestedArgs).toBe(4);
+	expect(events).toEqual([
+		{ phase: "enter", context: frame },
+		{ phase: "enter", context: undefined },
+		{ phase: "exit", context: undefined },
+		{ phase: "exit", context: frame },
+	]);
+	const completed = frame;
+	if (!isToolExecutionContext(completed)) throw new Error("Missing completed context");
+	expect(() => completed.assertValid()).toThrow("stale");
+});
+
+it("isolates concurrent native scopes and explicit legacy entry with reused call IDs", async () => {
+	const entries: (ToolExecutionContext | undefined)[] = [];
+	const matches: boolean[] = [];
+	let starts = 0;
+	let ready!: () => void;
+	let release!: (answer: boolean) => void;
+	const waiting = new Promise<void>((resolve) => {
+		ready = resolve;
+	});
+	const tool: AgentTool = {
+		name: "native",
+		label: "native",
+		description: "native",
+		parameters: Type.Object({}),
+		execute: async (_id, _args, _signal, _update, context) => {
+			matches.push(entries.at(-1) === context);
+			if (isToolExecutionContext(context)) await context.admit({ command: "harmless" });
+			starts++;
+			return { content: [], details: undefined };
+		},
+	};
+	registerToolExecutionContext(
+		tool.execute,
+		() => true,
+		async <T>(context: ToolExecutionContext | undefined, invoke: () => Promise<T>) => {
+			entries.push(context);
+			return invoke();
+		},
+	);
+	const options = { tools: [tool], context: { messages: [], tools: [tool] }, assistantMessage };
+	const call = { type: "toolCall" as const, id: "same", name: "native", arguments: {} };
+	const first = runToolCall(call, {
